class Solution {
    public int largestOverlap(int[][] img1, int[][] img2) {
        int n = img1.length;
        int max = 0;

        // Try every possible translation
        for (int dr = -n + 1; dr < n; dr++) {
            for (int dc = -n + 1; dc < n; dc++) {

                int overlap = 0;

                for (int i = 0; i < n; i++) {
                    for (int j = 0; j < n; j++) {

                        int x = i + dr;
                        int y = j + dc;

                        if (x >= 0 && x < n &&
                            y >= 0 && y < n &&
                            img1[i][j] == 1 &&
                            img2[x][y] == 1) {
                            overlap++;
                        }
                    }
                }

                max = Math.max(max, overlap);
            }
        }

        return max;
    }
}
